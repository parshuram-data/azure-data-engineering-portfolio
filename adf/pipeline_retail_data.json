{
  "name": "PL_Retail_Data_Engineering",
  "properties": {
    "description": "Metadata-driven Azure Data Factory pipeline for the Retail Data Platform using parameterized ADLS Gen2 datasets, Bronze ingestion, Databricks transformations, data quality validation and Gold processing.",

    "parameters": {
      "bronzeFolder": {
        "type": "String",
        "defaultValue": "bronze"
      },
      "silverFolder": {
        "type": "String",
        "defaultValue": "silver"
      },
      "goldFolder": {
        "type": "String",
        "defaultValue": "gold"
      }
    },

    "activities": [
      {
        "name": "Lookup_Source_Metadata",
        "type": "Lookup",
        "description": "Reads all source configuration records from the metadata control file.",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings"
            }
          },
          "firstRowOnly": false
        }
      },

      {
        "name": "Filter_Active_Sources",
        "type": "Filter",
        "description": "Processes only metadata records where IsActive is true.",
        "dependsOn": [
          {
            "activity": "Lookup_Source_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(toLower(string(item().IsActive)), 'true')",
            "type": "Expression"
          }
        }
      },

      {
        "name": "ForEach_Source_Table",
        "type": "ForEach",
        "description": "Iterates through active source configurations and dynamically copies each source into the Bronze layer.",
        "dependsOn": [
          {
            "activity": "Filter_Active_Sources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter_Active_Sources').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Copy_To_Bronze",
              "type": "Copy",
              "description": "Copies the source CSV defined by metadata into its configured Bronze target path.",
              "inputs": [
                {
                  "referenceName": "ds_retail_source_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "filePath": {
                      "value": "@substring(item().SourcePath, 0, lastIndexOf(item().SourcePath, '/'))",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@substring(item().SourcePath, add(lastIndexOf(item().SourcePath, '/'), 1), sub(length(item().SourcePath), add(lastIndexOf(item().SourcePath, '/'), 1)))",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_retail_bronze_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "folderPath": {
                      "value": "@concat(pipeline().parameters.bronzeFolder, '/', item().TargetPath)",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@concat(item().SourceName, '.csv')",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "DelimitedTextSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings",
                    "recursive": false
                  },
                  "formatSettings": {
                    "type": "DelimitedTextReadSettings"
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings",
                    "copyBehavior": "PreserveHierarchy"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": false
                  }
                }
              }
            }
          ]
        }
      },

      {
        "name": "Bronze_To_Silver_Databricks",
        "type": "DatabricksNotebook",
        "description": "Runs PySpark transformations to clean, standardize and deduplicate Bronze datasets before writing Delta tables to Silver.",
        "dependsOn": [
          {
            "activity": "ForEach_Source_Table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/bronze_to_silver",
          "baseParameters": {
            "source_path": "@pipeline().parameters.bronzeFolder",
            "target_path": "@pipeline().parameters.silverFolder"
          }
        }
      },

      {
        "name": "Data_Quality_Checks",
        "type": "DatabricksNotebook",
        "description": "Validates required fields, duplicates and business data quality rules on Silver datasets.",
        "dependsOn": [
          {
            "activity": "Bronze_To_Silver_Databricks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/data_quality_checks",
          "baseParameters": {
            "input_path": "@pipeline().parameters.silverFolder"
          }
        }
      },

      {
        "name": "Silver_To_Gold_Databricks",
        "type": "DatabricksNotebook",
        "description": "Creates analytics-ready Gold datasets using PySpark and Delta Lake.",
        "dependsOn": [
          {
            "activity": "Data_Quality_Checks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/silver_to_gold",
          "baseParameters": {
            "source_path": "@pipeline().parameters.silverFolder",
            "target_path": "@pipeline().parameters.goldFolder"
          }
        }
      },

      {
        "name": "Pipeline_Failure_Handling",
        "type": "WebActivity",
        "description": "Placeholder for production failure notification integration such as Azure Logic Apps, Teams or email.",
        "dependsOn": [
          {
            "activity": "Silver_To_Gold_Databricks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "method": "POST",
          "url": "https://example.com/ADF-Failure-Notification",
          "body": {
            "pipeline": "@pipeline().Pipeline",
            "runId": "@pipeline().RunId",
            "status": "Failed"
          }
        }
      }
    ]
  }
}
