{
  "name": "PL_Retail_Data_Engineering",
  "properties": {
    "description": "Production-minded metadata-driven Azure Data Factory pipeline for the Retail Data Platform using ADLS Gen2, Databricks, PySpark, Delta Lake and Medallion architecture.",
    "parameters": {
      "bronzeFolder": {
        "type": "String",
        "defaultValue": "bronze"
      },
      "silverFolder": {
        "type": "String",
        "defaultValue": "silver"
      },
      "goldFolder": {
        "type": "String",
        "defaultValue": "gold"
      }
    },
    "activities": [
      {
        "name": "Lookup_Source_Metadata",
        "type": "Lookup",
        "description": "Reads the centralized source configuration from pipeline_config.csv for metadata-driven ingestion.",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_pipeline_config_csv",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Filter_Active_Sources",
        "type": "Filter",
        "description": "Processes only active source configurations from the metadata control table.",
        "dependsOn": [
          {
            "activity": "Lookup_Source_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(toLower(string(item().IsActive)), 'true')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach_Source_Table",
        "type": "ForEach",
        "description": "Iterates through active source configurations and executes ingestion dynamically.",
        "dependsOn": [
          {
            "activity": "Filter_Active_Sources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter_Active_Sources').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Copy_To_Bronze",
              "type": "Copy",
              "description": "Copies the configured source file into the ADLS Gen2 Bronze layer using metadata-driven source and target paths.",
              "typeProperties": {
                "source": {
                  "type": "DelimitedTextSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextReadSettings"
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": false,
                    "fileExtension": ".csv"
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              },
              "inputs": [
                {
                  "referenceName": "ds_retail_source_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "filePath": {
                      "value": "@if(equals(lastIndexOf(item().SourcePath, '/'), -1), '', substring(item().SourcePath, 0, lastIndexOf(item().SourcePath, '/')))",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@if(equals(lastIndexOf(item().SourcePath, '/'), -1), item().SourcePath, substring(item().SourcePath, add(lastIndexOf(item().SourcePath, '/'), 1), sub(length(item().SourcePath), add(lastIndexOf(item().SourcePath, '/'), 1))))",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_retail_bronze_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "folderPath": {
                      "value": "@concat(pipeline().parameters.bronzeFolder, '/', item().TargetPath)",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@concat(item().SourceName, '.csv')",
                      "type": "Expression"
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "Bronze_To_Silver_Databricks",
        "type": "DatabricksNotebook",
        "description": "Transforms Bronze data using PySpark, applies standardization and deduplication, and writes curated Delta datasets to the Silver layer.",
        "dependsOn": [
          {
            "activity": "ForEach_Source_Table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/bronze_to_silver",
          "baseParameters": {
            "source_path": {
              "value": "@pipeline().parameters.bronzeFolder",
              "type": "Expression"
            },
            "target_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Data_Quality_Checks",
        "type": "DatabricksNotebook",
        "description": "Executes Silver-layer data quality checks for null values, duplicate keys and invalid business values.",
        "dependsOn": [
          {
            "activity": "Bronze_To_Silver_Databricks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/data_quality_checks",
          "baseParameters": {
            "input_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Silver_To_Gold_Databricks",
        "type": "DatabricksNotebook",
        "description": "Creates analytics-ready Gold Delta datasets from validated Silver data for downstream reporting and analytics.",
        "dependsOn": [
          {
            "activity": "Data_Quality_Checks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/silver_to_gold",
          "baseParameters": {
            "source_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            },
            "target_path": {
              "value": "@pipeline().parameters.goldFolder",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Pipeline_Failure_Handling",
        "type": "WebActivity",
        "description": "Placeholder for integration with an enterprise notification mechanism such as Azure Logic Apps, Microsoft Teams or email.",
        "dependsOn": [
          {
            "activity": "Silver_To_Gold_Databricks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "method": "POST",
          "url": "https://example.com/ADF-Failure-Notification",
          "body": {
            "pipeline": "@{pipeline().Pipeline}",
            "runId": "@{pipeline().RunId}",
            "status": "Failed"
          }
        }
      }
    ]
  }
}
