{
  "name": "pipeline_retail_data",
  "properties": {
    "description": "Metadata-driven retail ingestion pipeline with incremental watermark processing, Bronze to Silver transformation, watermark state management, data quality validation, and Gold publishing.",
    "parameters": {
      "bronzeFolder": {
        "type": "String",
        "defaultValue": "bronze"
      },
      "silverFolder": {
        "type": "String",
        "defaultValue": "silver"
      },
      "goldFolder": {
        "type": "String",
        "defaultValue": "gold"
      },
      "watermarkControlPath": {
        "type": "String",
        "defaultValue": "control/watermark_state"
      }
    },
    "activities": [
      {
        "name": "Lookup_Source_Metadata",
        "type": "Lookup",
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
          },
          "dataset": {
            "referenceName": "ds_pipeline_config_csv",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Lookup_Watermark_State",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Lookup_Source_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource"
          },
          "dataset": {
            "referenceName": "ds_watermark_state_csv",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Filter_Invalid_Metadata",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Lookup_Source_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@or(empty(item().SourceName),empty(item().SourceType),not(equals(toLower(trim(item().SourceType)),'csv')),empty(item().SourcePath),empty(item().TargetPath),and(not(equals(toLower(trim(item().LoadType)),'full')),not(equals(toLower(trim(item().LoadType)),'incremental'))),and(equals(toLower(trim(item().LoadType)),'incremental'),empty(item().WatermarkColumn)),not(equals(toLower(trim(item().TargetLayer)),'bronze')),and(not(equals(toLower(trim(item().IsActive)),'true')),not(equals(toLower(trim(item().IsActive)),'false'))))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Validate_Metadata",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Filter_Invalid_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(length(activity('Filter_Invalid_Metadata').output.value),0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Fail_Invalid_Metadata",
              "type": "Fail",
              "typeProperties": {
                "errorCode": "INVALID_METADATA",
                "message": "One or more active or configured metadata rows failed validation. Review pipeline_config.csv."
              }
            }
          ]
        }
      },
      {
        "name": "Filter_Active_Sources",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Validate_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(toLower(trim(item().IsActive)),'true')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach_Source_Table",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Filter_Active_Sources",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Lookup_Watermark_State",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter_Active_Sources').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Filter_Watermark_For_Source",
              "type": "Filter",
              "typeProperties": {
                "items": {
                  "value": "@activity('Lookup_Watermark_State').output.value",
                  "type": "Expression"
                },
                "condition": {
                  "value": "@equals(item().SourceName,items('ForEach_Source_Table').SourceName)",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "Copy_To_Bronze",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "Filter_Watermark_For_Source",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "DelimitedTextSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings",
                    "recursive": false,
                    "enablePartitionDiscovery": false
                  },
                  "formatSettings": {
                    "type": "DelimitedTextReadSettings"
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings",
                    "copyBehavior": "PreserveHierarchy"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": false
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              },
              "inputs": [
                {
                  "referenceName": "ds_retail_source_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "filePath": {
                      "value": "@if(equals(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),-1),'',substring(items('ForEach_Source_Table').SourcePath,0,lastIndexOf(items('ForEach_Source_Table').SourcePath,'/')))",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@if(equals(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),-1),items('ForEach_Source_Table').SourcePath,substring(items('ForEach_Source_Table').SourcePath,add(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),1),sub(length(items('ForEach_Source_Table').SourcePath),add(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),1))))",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_retail_bronze_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "folderPath": {
                      "value": "@concat(pipeline().parameters.bronzeFolder,'/',items('ForEach_Source_Table').TargetPath)",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@concat(items('ForEach_Source_Table').SourceName,'.csv')",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "Bronze_To_Silver_Databricks",
              "type": "DatabricksNotebook",
              "dependsOn": [
                {
                  "activity": "Copy_To_Bronze",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "notebookPath": "/Shared/azure-data-engineering-portfolio/pyspark/bronze_to_silver",
                "baseParameters": {
                  "source_path": {
                    "value": "@concat(pipeline().parameters.bronzeFolder,'/',items('ForEach_Source_Table').TargetPath)",
                    "type": "Expression"
                  },
                  "target_path": {
                    "value": "@pipeline().parameters.silverFolder",
                    "type": "Expression"
                  },
                  "source_name": {
                    "value": "@items('ForEach_Source_Table').SourceName",
                    "type": "Expression"
                  },
                  "load_type": {
                    "value": "@items('ForEach_Source_Table').LoadType",
                    "type": "Expression"
                  },
                  "watermark_column": {
                    "value": "@items('ForEach_Source_Table').WatermarkColumn",
                    "type": "Expression"
                  },
                  "last_successful_watermark": {
                    "value": "@if(greater(length(activity('Filter_Watermark_For_Source').output.value),0),first(activity('Filter_Watermark_For_Source').output.value).LastSuccessfulWatermark,'')",
                    "type": "Expression"
                  }
                }
              },
              "linkedServiceName": {
                "referenceName": "LS_Databricks",
                "type": "LinkedServiceReference"
              }
            },
            {
              "name": "Update_Watermark_If_Incremental",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "Bronze_To_Silver_Databricks",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@equals(toLower(trim(items('ForEach_Source_Table').LoadType)),'incremental')",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "Update_Watermark",
                    "type": "DatabricksNotebook",
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 1,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "typeProperties": {
                      "notebookPath": "/Shared/azure-data-engineering-portfolio/control/update_watermark",
                      "baseParameters": {
                        "control_path": {
                          "value": "@pipeline().parameters.watermarkControlPath",
                          "type": "Expression"
                        },
                        "source_name": {
                          "value": "@items('ForEach_Source_Table').SourceName",
                          "type": "Expression"
                        },
                        "watermark_column": {
                          "value": "@items('ForEach_Source_Table').WatermarkColumn",
                          "type": "Expression"
                        },
                        "old_watermark": {
                          "value": "@if(greater(length(activity('Filter_Watermark_For_Source').output.value),0),first(activity('Filter_Watermark_For_Source').output.value).LastSuccessfulWatermark,'')",
                          "type": "Expression"
                        },
                        "new_watermark": {
                          "value": "@json(activity('Bronze_To_Silver_Databricks').output.runOutput).new_watermark",
                          "type": "Expression"
                        },
                        "run_id": {
                          "value": "@pipeline().RunId",
                          "type": "Expression"
                        },
                        "records_processed": {
                          "value": "@json(activity('Bronze_To_Silver_Databricks').output.runOutput).records_processed",
                          "type": "Expression"
                        },
                        "status": {
                          "value": "@json(activity('Bronze_To_Silver_Databricks').output.runOutput).status",
                          "type": "Expression"
                        }
                      }
                    },
                    "linkedServiceName": {
                      "referenceName": "LS_Databricks",
                      "type": "LinkedServiceReference"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Data_Quality_Checks",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "ForEach_Source_Table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/pyspark/data_quality_checks",
          "baseParameters": {
            "silver_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_Databricks",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Silver_To_Gold_Databricks",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Data_Quality_Checks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/pyspark/silver_to_gold",
          "baseParameters": {
            "silver_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            },
            "gold_path": {
              "value": "@pipeline().parameters.goldFolder",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "LS_Databricks",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Pipeline_Failure_Handling",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "Silver_To_Gold_Databricks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "POST",
          "url": "https://example.invalid/retail-pipeline-alert",
          "body": {
            "value": "@concat('{\"pipeline\":\"',pipeline().Pipeline,'\",\"runId\":\"',pipeline().RunId,'\",\"status\":\"Failed\"}')",
            "type": "Expression"
          }
        }
      }
    ]
  }
}
