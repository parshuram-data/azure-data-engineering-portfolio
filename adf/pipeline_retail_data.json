{
  "name": "PL_Retail_Data_Engineering",
  "properties": {
    "description": "Production-minded metadata-driven Azure Data Factory pipeline for the Retail Data Platform using ADLS Gen2, Databricks, PySpark, Delta Lake and Medallion architecture.",
    "parameters": {
      "bronzeFolder": {
        "type": "String",
        "defaultValue": "bronze"
      },
      "silverFolder": {
        "type": "String",
        "defaultValue": "silver"
      },
      "goldFolder": {
        "type": "String",
        "defaultValue": "gold"
      }
    },
    "activities": [
      {
        "name": "Lookup_Source_Metadata",
        "type": "Lookup",
        "description": "Reads the centralized source configuration from pipeline_config.csv for metadata-driven ingestion.",
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_pipeline_config_csv",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Lookup_Watermark_State",
        "type": "Lookup",
        "description": "Reads the last successfully processed watermark for each configured source.",
        "dependsOn": [
          {
            "activity": "Lookup_Source_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "dataset": {
            "referenceName": "ds_watermark_state_csv",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Filter_Invalid_Metadata",
        "type": "Filter",
        "description": "Identifies invalid metadata configurations before source ingestion begins.",
        "dependsOn": [
          {
            "activity": "Lookup_Watermark_State",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@or(empty(item().SourceName),empty(item().SourceType),not(equals(toLower(trim(item().SourceType)),'csv')),empty(item().SourcePath),empty(item().TargetPath),and(not(equals(toLower(trim(item().LoadType)),'full')),not(equals(toLower(trim(item().LoadType)),'incremental'))),and(equals(toLower(trim(item().LoadType)),'incremental'),empty(item().WatermarkColumn)),not(equals(toLower(trim(item().TargetLayer)),'bronze')),and(not(equals(toLower(trim(item().IsActive)),'true')),not(equals(toLower(trim(item().IsActive)),'false'))))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Validate_Metadata",
        "type": "IfCondition",
        "description": "Stops the pipeline when one or more metadata configuration records fail validation.",
        "dependsOn": [
          {
            "activity": "Filter_Invalid_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(length(activity('Filter_Invalid_Metadata').output.value),0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Fail_Invalid_Metadata",
              "type": "Fail",
              "description": "Fails the pipeline because invalid metadata configuration was detected.",
              "typeProperties": {
                "errorCode": "ADF_METADATA_VALIDATION_FAILED",
                "message": "One or more source metadata records failed validation. Review pipeline_config.csv before running ingestion."
              }
            }
          ]
        }
      },
      {
        "name": "Filter_Active_Sources",
        "type": "Filter",
        "description": "Processes only active and validated source configurations.",
        "dependsOn": [
          {
            "activity": "Validate_Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_Source_Metadata').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@equals(toLower(trim(item().IsActive)),'true')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach_Source_Table",
        "type": "ForEach",
        "description": "Iterates through active source configurations and resolves the corresponding watermark before processing each source.",
        "dependsOn": [
          {
            "activity": "Filter_Active_Sources",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter_Active_Sources').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Filter_Watermark_For_Source",
              "type": "Filter",
              "description": "Finds the watermark state record corresponding to the current source.",
              "typeProperties": {
                "items": {
                  "value": "@activity('Lookup_Watermark_State').output.value",
                  "type": "Expression"
                },
                "condition": {
                  "value": "@equals(toLower(trim(item().SourceName)),toLower(trim(items('ForEach_Source_Table').SourceName)))",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "Copy_To_Bronze",
              "type": "Copy",
              "description": "Copies the configured raw source file into the ADLS Gen2 Bronze layer. The raw source is preserved before curated incremental processing.",
              "dependsOn": [
                {
                  "activity": "Filter_Watermark_For_Source",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "DelimitedTextSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextReadSettings"
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": false,
                    "fileExtension": ".csv"
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              },
              "inputs": [
                {
                  "referenceName": "ds_retail_source_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "filePath": {
                      "value": "@if(equals(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),-1),'',substring(items('ForEach_Source_Table').SourcePath,0,lastIndexOf(items('ForEach_Source_Table').SourcePath,'/')))",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@if(equals(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),-1),items('ForEach_Source_Table').SourcePath,substring(items('ForEach_Source_Table').SourcePath,add(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),1),sub(length(items('ForEach_Source_Table').SourcePath),add(lastIndexOf(items('ForEach_Source_Table').SourcePath,'/'),1))))",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_retail_bronze_csv",
                  "type": "DatasetReference",
                  "parameters": {
                    "folderPath": {
                      "value": "@concat(pipeline().parameters.bronzeFolder,'/',items('ForEach_Source_Table').TargetPath)",
                      "type": "Expression"
                    },
                    "fileName": {
                      "value": "@concat(items('ForEach_Source_Table').SourceName,'.csv')",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "Bronze_To_Silver_Databricks",
              "type": "DatabricksNotebook",
              "description": "Processes the current source from Bronze to Silver using the resolved incremental control state.",
              "dependsOn": [
                {
                  "activity": "Copy_To_Bronze",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "notebookPath": "/Shared/azure-data-engineering-portfolio/bronze_to_silver",
                "baseParameters": {
                  "source_path": {
                    "value": "@concat(pipeline().parameters.bronzeFolder,'/',items('ForEach_Source_Table').TargetPath)",
                    "type": "Expression"
                  },
                  "target_path": {
                    "value": "@pipeline().parameters.silverFolder",
                    "type": "Expression"
                  },
                  "source_name": {
                    "value": "@items('ForEach_Source_Table').SourceName",
                    "type": "Expression"
                  },
                  "load_type": {
                    "value": "@items('ForEach_Source_Table').LoadType",
                    "type": "Expression"
                  },
                  "watermark_column": {
                    "value": "@items('ForEach_Source_Table').WatermarkColumn",
                    "type": "Expression"
                  },
                  "last_successful_watermark": {
                    "value": "@if(greater(length(activity('Filter_Watermark_For_Source').output.value),0),first(activity('Filter_Watermark_For_Source').output.value).LastSuccessfulWatermark,'')",
                    "type": "Expression"
                  }
                }
              }
            }
          ]
        }
      },

      {
        "name": "Data_Quality_Checks",
        "type": "DatabricksNotebook",
        "description": "Executes Silver-layer data quality checks for null values, duplicate keys and invalid business values.",
        "dependsOn": [
          {
            "activity": "ForEach_Source_Table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/data_quality_checks",
          "baseParameters": {
            "input_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            }
          }
        }
      },

      {
        "name": "Silver_To_Gold_Databricks",
        "type": "DatabricksNotebook",
        "description": "Creates analytics-ready Gold Delta datasets from validated Silver data for downstream reporting and analytics.",
        "dependsOn": [
          {
            "activity": "Data_Quality_Checks",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/azure-data-engineering-portfolio/silver_to_gold",
          "baseParameters": {
            "source_path": {
              "value": "@pipeline().parameters.silverFolder",
              "type": "Expression"
            },
            "target_path": {
              "value": "@pipeline().parameters.goldFolder",
              "type": "Expression"
            }
          }
        }
      },

      {
        "name": "Pipeline_Failure_Handling",
        "type": "WebActivity",
        "description": "Placeholder for integration with an enterprise notification mechanism such as Azure Logic Apps, Microsoft Teams or email.",
        "dependsOn": [
          {
            "activity": "Silver_To_Gold_Databricks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "method": "POST",
          "url": "https://example.com/ADF-Failure-Notification",
          "body": {
            "pipeline": "@{pipeline().Pipeline}",
            "runId": "@{pipeline().RunId}",
            "status": "Failed"
          }
        }
      }
    ]
  }
}
