{
  "name": "ds_retail_source_csv",
  "properties": {
    "description": "Parameterized CSV source dataset used by the metadata-driven retail ingestion pipeline.",
    "linkedServiceName": {
      "referenceName": "LS_ADLS_Gen2",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "filePath": {
        "type": "String"
      },
      "fileName": {
        "type": "String"
      }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "folderPath": {
          "value": "@dataset().filePath",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().fileName",
          "type": "Expression"
        }
      },
      "columnDelimiter": ",",
      "firstRowAsHeader": true,
      "quoteChar": "\"",
      "escapeChar": "\\"
    }
  }
}
